# Local database (Node 24+ built-in SQLite; relative to the workspace when using pnpm from root)
SQLITE_PATH=./data/ai-study.sqlite

# AI
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_API_KEY=

# S3 (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
# Path-style required for R2/MinIO (default true); set false for AWS virtual-hosted
S3_FORCE_PATH_STYLE=true
# Optional public CDN base — if set, read URLs use this instead of presigned GET
S3_PUBLIC_BASE_URL=

# Admin
ADMIN_EMAILS=admin@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
