{
  "name": "visual-ast",
  "version": "0.1.0",
  "description": "Structured visual AST for math/science diagrams — AI → AST → Renderer. Geometry, function graphs, physics diagrams. Zero runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "demo",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ts-check": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "build-demo": "node scripts/build-demo.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "ast",
    "geometry",
    "math",
    "physics",
    "svg",
    "education",
    "renderer",
    "ai"
  ],
  "license": "MIT"
}
